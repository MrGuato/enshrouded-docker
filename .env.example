# =============================================================================
# Enshrouded Dedicated Server — Environment Configuration (.env)
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# =============================================================================

# --- Server Identity & Capacity ---
SERVER_NAME="My Enshrouded Server"
SERVER_SLOTS=16

# --- Authentication (Choose Option A OR Option B) ---
# Option A: Single server password for all players (leave empty for public server)
SERVER_PASSWORD=""

# Option B: Role-based userGroup passwords (overrides SERVER_PASSWORD if any are set)
ADMIN_PASSWORD=""
FRIEND_PASSWORD=""
GUEST_PASSWORD=""

# --- Networking ---
# Modern Enshrouded uses QUERY_PORT (default 15637/udp) for both traffic and discovery
QUERY_PORT=15637
GAME_PORT=15637

# --- In-Game Features & Difficulty ---
ENABLE_VOICE_CHAT=false
ENABLE_TEXT_CHAT=false
VOICE_CHAT_MODE=Proximity
# Presets: Default, Relaxed, Hard, Survival, Custom
GAME_SETTINGS_PRESET=Default

# --- Container Behavior & Permissions ---
UPDATE_ON_START=1
SYNC_CONFIG_ON_START=1
PUID=1000
PGID=1000
TZ=UTC
