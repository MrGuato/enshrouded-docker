# ---------------------------------------------------------------------------
# Server identity
# ---------------------------------------------------------------------------
SERVER_NAME=My Enshrouded Server
# 1 to 16
SERVER_SLOTS=16
TZ=UTC

# ---------------------------------------------------------------------------
# Passwords: use SERVER_PASSWORD, or the role passwords below (any role password wins)
# Leaving all four empty keeps the passwords already in enshrouded_server.json.
# ---------------------------------------------------------------------------
# one password for everyone, with full rights
SERVER_PASSWORD=
# Admin: kick and ban, build, open chests
ADMIN_PASSWORD=
# Friend: build and open chests
FRIEND_PASSWORD=
# Guest: explore and fight, no building or chests
GUEST_PASSWORD=

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
IMAGE_REPOSITORY=ghcr.io/mrguato/enshrouded-docker
# pin a release like 1.0.0, latest tracks main
IMAGE_TAG=latest
CONTAINER_NAME=enshrouded-server

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# UID/GID the server runs as; match the owner of the enshrouded-* folders. PUID=0 runs as root.
PUID=1000
PGID=1000
# validate / update the game files through SteamCMD on every container start
UPDATE_ON_START=true
# write the settings in this file into enshrouded_server.json on every start
SYNC_CONFIG_ON_START=true
QUERY_PORT=15637
# seconds the server gets to exit after Ctrl+C when the container stops
STOP_TIMEOUT=90

# ---------------------------------------------------------------------------
# Game settings
# ---------------------------------------------------------------------------
ENABLE_VOICE_CHAT=false
# Proximity | Global
VOICE_CHAT_MODE=Proximity
ENABLE_TEXT_CHAT=false
# Default | Relaxed | Hard | Survival | Custom
# Never overwritten while enshrouded_server.json says Custom, so tuned gameSettings stay put.
GAME_SETTINGS_PRESET=Default
